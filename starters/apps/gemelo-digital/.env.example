# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Tu número personal para recibir avisos cuando el gemelo necesite que intervengas
# Formato internacional sin "+" ni espacios. Ej. Honduras: 50499998888
NUMERO_DUENO=

# Números que el gemelo NO debe contestar (separados por coma). Ej. familia cercana
NUMEROS_IGNORADOS=

# Cuántos mensajes recientes recuerda por contacto
MEMORIA_MENSAJES=30
